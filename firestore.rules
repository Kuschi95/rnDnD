rules_version = '2';
// Target rules for project dndniko-4de7a. Do not deploy this file from CI.
//
// Deploying it before the members repair will break the Kotlin DM:
// `members` stores the host uid and player character ids, and character
// documents do not point at a lobby. `isDmOfCharacter` therefore only
// succeeds after a character has an additive `lobbyCode` field whose lobby
// host is the caller and whose members contain that character id. Gson on
// Android ignores unknown fields, so `lobbyCode` does not have to be removed
// for the old client to keep parsing. Until that backfill, leave the console
// rules in place and do not publish these.
//
// Monster reads are "any signed-in user who knows the lobby code". A player
// uid is not in `members`, so a membership check cannot be expressed yet.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function lobbyDoc(lobbyCode) {
      return get(/databases/$(database)/documents/lobbies/$(lobbyCode));
    }

    function isLobbyHost(lobbyCode) {
      return signedIn() && lobbyDoc(lobbyCode).data.host == request.auth.uid;
    }

    function isDmOfCharacter(characterId) {
      return signedIn()
        && resource.data.keys().hasAny(['lobbyCode'])
        && resource.data.lobbyCode is string
        && exists(/databases/$(database)/documents/lobbies/$(resource.data.lobbyCode))
        && lobbyDoc(resource.data.lobbyCode).data.host == request.auth.uid
        && characterId in lobbyDoc(resource.data.lobbyCode).data.members;
    }

    function addedMembers() {
      return request.resource.data.members.removeAll(resource.data.members);
    }

    function hostUpdatesLobby() {
      return resource.data.host == request.auth.uid
        && request.resource.data.host == resource.data.host
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'countdown']);
    }

    function playerJoinsWithOwnCharacter() {
      return request.resource.data.host == resource.data.host
        && request.resource.data.countdown == resource.data.countdown
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && addedMembers().size() == 1
        && get(/databases/$(database)/documents/characters/$(addedMembers()[0])).data.userId == request.auth.uid;
    }

    function chatInvolvesHost(data, lobbyCode) {
      return data.senderId == lobbyDoc(lobbyCode).data.host
        || data.receiverId == lobbyDoc(lobbyCode).data.host;
    }

    function callerIsOnMessage(data) {
      return request.auth.uid == data.senderId || request.auth.uid == data.receiverId;
    }

    function chatVisible(data, lobbyCode) {
      return signedIn()
        && data.senderId is string
        && data.receiverId is string
        && chatInvolvesHost(data, lobbyCode)
        && callerIsOnMessage(data);
    }

    match /characters/{characterId} {
      allow get, list: if signedIn() && (
        resource.data.userId == request.auth.uid || isDmOfCharacter(characterId)
      );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == characterId;

      allow update: if signedIn()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == characterId
        && (
          resource.data.userId == request.auth.uid
          || isDmOfCharacter(characterId)
        );

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /lobbies/{lobbyCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      allow update: if signedIn() && (hostUpdatesLobby() || playerJoinsWithOwnCharacter());

      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      match /monsters/{monsterId} {
        allow read: if signedIn();
        allow create, update, delete: if isLobbyHost(lobbyCode);
      }

      match /chats/{chatId} {
        allow get, list: if chatVisible(resource.data, lobbyCode);

        allow create: if chatVisible(request.resource.data, lobbyCode)
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.message is string
          && request.resource.data.timestamp is string
          && request.resource.data.read is bool
          && request.resource.data.keys().hasOnly(['senderId', 'receiverId', 'message', 'timestamp', 'read']);

        allow update: if chatVisible(resource.data, lobbyCode)
          && chatVisible(request.resource.data, lobbyCode)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.message == resource.data.message
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }
    }
  }
}
